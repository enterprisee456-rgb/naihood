---
const { initials, name, handle, location, time, content, likes, comments, shares, image } = Astro.props
---
<article class="group bg-[#101012] border border-white/[0.07] rounded-[24px] overflow-hidden hover:border-white/[0.12] transition-all duration-300">
  {image && <img src={image} class="w-full h-[340px] object-cover" loading="lazy" />}
  <div class="p-5">
    <div class="flex gap-3">
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-violet-500 to-indigo-600 grid place-items-center font-black text-[12px] shrink-0">{initials}</div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="font-bold text-[15px]">{name}</span>
          <span class="text-zinc-500 text-[13px]">@{handle} · 📍 {location} · {time}</span>
        </div>
        <p class="text-[15px] leading-6 text-zinc-200 mt-2.5">{content}</p>
        <div class="flex items-center gap-6 mt-4">
          <button class="text-zinc-500 hover:text-pink-400 transition text-[13px] flex items-center gap-1.5">♡ {likes}</button>
          <button class="text-zinc-500 hover:text-white transition text-[13px] flex items-center gap-1.5">💬 {comments}</button>
          <button class="text-zinc-500 hover:text-white transition text-[13px] flex items-center gap-1.5">↗ {shares}</button>
        </div>
      </div>
      <button class="text-zinc-600 hover:text-white h-fit">•••</button>
    </div>
  </div>
</article>
