<html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<style>*{box-sizing:border-box} body{margin:0;background:#0A0A0B;color:#fff;font-family:system-ui}.top{padding:14px 16px;border-bottom:1px solid #1E1E20;display:flex;justify-content:space-between}.wrap{max-width:480px;margin:0 auto;padding:16px} textarea{width:100%;background:#151517;border:1px solid #2A2A2A;border-radius:16px;padding:16px;color:#fff;min-height:120px;resize:none;outline:none} select{width:100%;background:#151517;border:1px solid #2A2A2A;border-radius:12px;padding:12px;color:#fff;margin:10px 0}.btn{width:100%;background:#A78BFA;color:#000;border:0;padding:14px;border-radius:12px;font-weight:800;margin-top:10px;cursor:pointer}</style></head>
<body><div class="top"><a href="/" style="color:#fff;text-decoration:none">← Back</a><b>New Post</b><span></span></div><div class="wrap"><textarea id="text" placeholder="What's happening in your hood?" maxlength="280"></textarea><select id="hood"><option>Milimani</option><option>Township</option><option>Matisi</option><option>Kipsongo</option><option>Bidii</option><option>Tuwani</option></select><button class="btn" id="btn">Post to hood</button></div><script>if(!localStorage.getItem('nai_user'))location.href='/login';document.getElementById('hood').value=localStorage.getItem('nai_hood')||'Township';document.getElementById('btn').onclick=async()=>{const t=document.getElementById('text').value.trim();if(!t)return;const user=localStorage.getItem('nai_user');const hood=document.getElementById('hood').value;document.getElementById('btn').innerText='Posting...';try{await fetch('/api/posts',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:user,hood,text:t})});location.href='/';}catch(e){alert('failed');document.getElementById('btn').innerText='Post to hood';}}</script></body></html>
