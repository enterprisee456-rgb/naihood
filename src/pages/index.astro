---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

const posts = [
  {
    initials: "MN",
    name: "Maya Naliaka",
    handle: "maya.n",
    location: "Milimani",
    time: "12m",
    likes: 62,
    comments: 14,
    shares: 5,
    image: "https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?q=80&w=1200&auto=format",
    content: "Power is finally back on in Milimani. A very big thank you to the KPLC crew on the ground - the whole block is cheering ⚡"
  },
  {
    initials: "BK",
    name: "Brian K.",
    handle: "brian.k",
    location: "Township",
    time: "1h",
    likes: 28,
    comments: 9,
    shares: 2,
    image: "",
    content: "Route 7 matatus avoiding the main stage due to jam. Use the back road through county offices."
  },
  {
    initials: "JW",
    name: "Joy W.",
    handle: "joy.w",
    location: "Matisi",
    time: "3h",
    likes: 41,
    comments: 6,
    shares: 8,
    image: "https://images.unsplash.com/photo-1488459716781-31db52582fe9?q=80&w=1200&auto=format",
    content: "Fresh sukuma and tomatoes at Matisi market today. Mama Mboga near the stage has the best prices."
  }
]
---
<BaseLayout>
  <div class="min-h-screen bg-[#050507] text-white selection:bg-violet-500/30">
    <div class="pointer-events-none fixed -top-40 -left-40 w-[600px] h-[600px] bg-violet-600/15 blur-[120px] rounded-full"></div>
    <div class="pointer-events-none fixed -bottom-40 -right-40 w-[600px] h-[600px] bg-indigo-600/10 blur-[120px] rounded-full"></div>
    <main class="relative max-w-[680px] mx-auto px-4 md:px-6 pt-16 pb-28">
      <div class="flex items-baseline justify-between mb-8">
        <div>
          <div class="text-[11px] font-bold tracking-[0.18em] text-zinc-500">LIVE FROM AROUND HERE</div>
          <h1 class="text-[32px] font-black tracking-tighter mt-1">Your neighborhood feed</h1>
        </div>
        <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
      </div>
      <div class="flex flex-col gap-5">
        {posts.map(p => <PostCard {...p} />)}
      </div>
      <div class="mt-16 text-center text-zinc-600 text-sm">
        Kitale HQ • Milimani • Matisi • Township
      </div>
    </main>
  </div>
</BaseLayout>
