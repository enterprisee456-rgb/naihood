<html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<style>
*{box-sizing:border-box} body{margin:0;background:#0A0A0B;color:#fff;font-family:system-ui;height:100vh;display:flex;align-items:center;justify-content:center}
.bg{position:fixed;inset:0;background:radial-gradient(600px at 20% 10%, #4C1D95 0%, transparent 60%),radial-gradient(600px at 90% 90%, #1E1B4B 0%, transparent 60%)}
.card{width:100%;max-width:380px;background:#16161A;border:1px solid #2A2A2E;border-radius:24px;padding:28px;margin:16px}
.logo{font-size:34px;font-weight:900;letter-spacing:-1px} .logo b{color:#A78BFA}
.sub{color:#9CA3AF;font-size:13px;margin:8px 0 24px}
input{width:100%;background:#0F0F10;border:1px solid #2A2A2A;border-radius:12px;padding:14px;margin:8px 0;color:#fff;outline:none}
input:focus{border-color:#A78BFA} .btn{width:100%;background:#fff;color:#000;border:0;padding:14px;border-radius:12px;font-weight:800;margin-top:14px;cursor:pointer}
</style></head>
<body><div class="bg"></div>
<div class="card">
<div class="logo">nai<b>hood</b></div>
<div class="sub">Your hood. Your people. Kitale HQ.</div>
<input placeholder="Phone 07XX XXX XXX"/><input type="password" placeholder="Password"/>
<button class="btn" onclick="location.href='/'">Continue</button>
<p style="text-align:center;margin-top:18px;color:#666;font-size:12px">Pioneer - Milimani - Lessos - Township<br/>HQ: Kitale Town</p>
</div></body></html>
