<html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<style>*{box-sizing:border-box} body{margin:0;background:#0A0A0B;color:#fff;font-family:system-ui;min-height:100vh}.p-4{padding:1rem}.min-h-screen{min-height:100vh}.flex{display:flex}.items-center{align-items:center}.justify-center{justify-content:center}.bg{position:fixed;inset:0;background:radial-gradient(600px at 20% 10%, #4C1D95 0%, transparent 60%)}.card{width:100%;max-width:28rem;margin:0 auto;background:#16161A;border:1px solid #2A2A2E;border-radius:24px;padding:28px 1rem} input,select{width:100%;background:#0F0F10;border:1px solid #2A2A2E;border-radius:12px;padding:14px;margin:8px 0;color:#fff}.btn{width:100%;background:#A78BFA;color:#000;border:0;padding:14px;border-radius:12px;font-weight:800;margin-top:14px;cursor:pointer}</style></head>
<body class="p-4 min-h-screen flex items-center justify-center"><div class="bg"></div><div class="card w-full max-w-md mx-auto px-4"><div style="font-size:32px;font-weight:900">Join nai<b style="color:#A78BFA">hood</b></div><p style="color:#9CA3AF;font-size:13px">Kitale HQ</p><input id="user" placeholder="@username"/><select id="hood"><option>Milimani</option><option>Township</option><option>Matisi</option><option>Kipsongo</option><option>Bidii</option><option>Tuwani</option></select><input type="password" placeholder="Password"/><button class="btn" id="btn">Create account</button><p style="text-align:center;color:#666;font-size:12px;margin-top:12px">Have account? <a href="/login" style="color:#A78BFA">Login</a></p></div>
<script>document.getElementById('btn').onclick=async()=>{const u=document.getElementById('user').value.replace('@','').trim();const h=document.getElementById('hood').value;if(u.length<3){alert('pick username');return}try{await fetch('/api/auth',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,hood:h})})}catch(e){}localStorage.setItem('nai_user',u);localStorage.setItem('nai_hood',h);location.href='/';}</script></body></html>
