generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ListingType {
  RENT
  SALE
}

enum PropertyType {
  APARTMENT
  HOUSE
  BED_SITTER
  STUDIO
  LAND
  COMMERCIAL
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD
  RENTED
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  email     String?  @unique
  passwordHash String?
  role      String   @default("SEEKER")
  createdAt DateTime @default(now())
  listings  Listing[]
  inquiries Inquiry[]
  savedListings SavedListing[]
  recentSearches RecentSearch[]
  conversationsAsSeeker Conversation[] @relation("SeekerConversations")
  conversationsAsOwner Conversation[] @relation("OwnerConversations")
  messages Message[]
  notifications Notification[]
}

model Location {
  id       String    @id @default(cuid())
  county   String
  town     String
  estate   String
  listings Listing[]

  @@index([county, town, estate])
}

model Listing {
  id           String        @id @default(cuid())
  title        String
  description  String
  type         ListingType
  propertyType PropertyType
  priceKes     Int
  bedrooms     Int?
  bathrooms    Int?
  amenities    String        @default("")
  imageUrl     String
  status       ListingStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location      @relation(fields: [locationId], references: [id])
  inquiries    Inquiry[]
  saves        SavedListing[]
  conversations Conversation[]

  @@index([status, type, priceKes])
  @@index([status, propertyType, priceKes, bedrooms, bathrooms, createdAt])
  @@index([locationId])
}

model SavedListing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
}

model RecentSearch {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  userId        String
  label         String
  q             String   @default("")
  county        String   @default("")
  town          String   @default("")
  estate        String   @default("")
  type          String   @default("")
  propertyType  String   @default("")
  minPrice      Int?
  maxPrice      Int?
  minBedrooms   Int?
  minBathrooms  Int?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Conversation {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  listingId  String
  seekerId   String
  ownerId    String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seeker     User     @relation("SeekerConversations", fields: [seekerId], references: [id], onDelete: Cascade)
  owner      User     @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([listingId, seekerId, ownerId])
  @@index([seekerId, updatedAt])
  @@index([ownerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  body           String
  readAt         DateTime?
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  readAt    DateTime?
  type      String
  title     String
  body      String
  href      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Inquiry {
  id           String   @id @default(cuid())
  message      String
  contactPhone String
  createdAt    DateTime @default(now())
  seekerId     String
  listingId    String
  seeker       User     @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
